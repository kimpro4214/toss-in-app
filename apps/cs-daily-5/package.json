{
  "name": "cs-daily-5",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "validate:content": "tsx scripts/validate-content.ts && tsx scripts/validate-interview.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:web": "npm run validate:content && npm run typecheck && vite build",
    "build": "npm run build:web && ait build",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "3.7.0",
    "@emotion/react": "^11.14.0",
    "@toss/tds-mobile": "2.4.1",
    "@toss/tds-mobile-ait": "2.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "4.1.11"
  }
}
